# Supabase 配置（在 Supabase 项目 Settings > API 中获取）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 仅服务端使用，绝不能暴露到客户端组件 / NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 站点域名（用于 SEO / sitemap / 绝对 URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 中英文页面共用该站点地址；不要在末尾添加 /en。
# canonical、hreflang、Open Graph 与 sitemap 会自动生成中文无前缀和英文 /en URL。

# Demo / Mock Preview 模式（true 时前台使用 mock 数据，不请求 Supabase）
# 生产 / 正常开发环境请保持 false；如需纯前端预览，请参考 .env.demo.example
NEXT_PUBLIC_DEMO_MODE=false

# Schema 兼容 fallback 开关（KZQ-P0-010，仅服务端使用）
# 当关键 RPC（如 count_unread_inquiries / get_admin_dashboard_snapshot）未部署
# 或权限缺失时，是否允许回退到直接表查询。
#   - 生产环境（NODE_ENV=production）默认 OFF：未部署的 RPC 必须以固定错误码
#     暴露，避免掩盖 migration 未应用。check-release-readiness 在生产模式下
#     检测到该值为 true 会直接 BLOCK。
#   - 非生产环境（开发 / 测试 / Demo）默认 ON：本地部分 migration 未应用时
#     仪表盘和未读询盘徽章仍可工作。
#   - 严格匹配 "true" 才视为开启；"TRUE"、"1"、"yes" 均不接受。
# 仅在确有兼容需要（如经批准的临时兼容环境）时显式设置为 true。
# ALLOW_SCHEMA_COMPATIBILITY_FALLBACK=

# CI-only build mock backend (Review #3 WP5)
# 仅用于 CI 环境（process.env.CI === "true"）且主机名为 localhost/127.0.0.1
# 时启用本地 mock Supabase 服务器以完成生产构建契约验证。
# 不建议普通开发或生产环境配置；生产 / Staging 部署中出现该标志会被
# check-release-readiness 直接 BLOCK。next.config.mjs 会在非 CI 或非
# loopback 主机上检测到该标志时立即失败构建。
# BUILD_MOCK_BACKEND=

# 搜索引擎索引开关（严格匹配 "true" 才允许索引；其他值或未设置一律 noindex）
# 默认关闭。EdgeOne 正式域名验收通过后才设置为 true。
# Vercel Preview 与当前 Vercel Production 一律保持 false，避免占位内容被收录。
NEXT_PUBLIC_SITE_INDEXING_ENABLED=false

# 可选：仅 Staging 的受保护依赖诊断。两个变量必须同时通过部署平台 Secret 配置。
# 未启用时 /api/staging/diagnostics 返回 404；不要把 Token 写入浏览器或日志。
STAGING_DIAGNOSTICS_ENABLED=false
STAGING_DIAGNOSTICS_TOKEN=

# 以下仅用于本机/手动 GitHub staging 验证，不是应用运行所需变量。
# 写入测试还必须显式设置对应 ALLOW_WRITES=true；默认只读。
# KZQ_STAGING_CONFIRMATION=KZQ-STAGING-ONLY
# SMOKE_TEST_ALLOW_WRITES=false
# STAGING_E2E_ALLOW_WRITES=false
# DATABASE_STAGING_URL=
# KZQ_STAGING_PROJECT_REF=

# 产品搜索 RPC 与匿名询盘清单不需要新增环境变量。
# 询盘清单仅保存在浏览器 localStorage，不保存联系人信息。
# 采购资料、证书查看器与应用案例功能也不需要新增环境变量；文件继续使用 public-assets。

# 可选：限流可信代理 Header（仅服务端使用）
# 必须是以下固定枚举之一：
#   eo-connecting-ip     — EdgeOne（腾讯）
#   x-edgeone-client-ip  — EdgeOne（旧别名）
#   x-real-ip            — Nginx / 通用代理
#   cf-connecting-ip     — Cloudflare
# 未配置或非法值时 getClientIp 返回 null，限流使用 fallback bucket。
# 生产环境（EdgeOne）推荐设置为 eo-connecting-ip。
TRUSTED_PROXY_HEADER=

# 可选：限流 fallback HMAC Secret（仅服务端使用）
# 当无法获取可信 IP 时，使用此 Secret 对 User-Agent 等做 HMAC 生成分桶 key。
# 至少 32 字符；未配置或过短时生产环境使用单一严格 fallback:global 桶。
RATE_LIMIT_FALLBACK_SECRET=

# KZQ-P1-011-b: 分布式限流后端驱动（可选）
# 默认（未设置或 "memory"）使用进程内 MemoryRateLimiter，仅单进程内一致。
# 设为 "postgres" 时使用 PostgreSQL 原子 RPC（rate_limit_check，migration
# 20260801000000_distributed_rate_limit_rpc.sql）实现多实例共享的固定窗口计数。
# 仅接受精确字符串 "postgres"（"postgres"/其他值按 memory 处理，不会静默切换）。
# 生产环境如需强全局一致性应设为 postgres，并同时配置 EdgeOne WAF 作为兜底层。
RATE_LIMIT_DRIVER=memory

# KZQ-P1-011-a: 分布式限流边界人工验收标志（仅生产环境必需）
# 应用层 MemoryRateLimiter 仅在单进程内一致，EdgeOne 多实例部署时实际限流阈值为
# N × 配置值（N = 运行实例数），不是真正的生产级限流。
# EdgeOne WAF / Rate Limiting 规则提供跨实例 floor，是生产限流的真实执行点。
# 运维人员在 EdgeOne 控制台按照 docs/EDGEONE_WAF_RULES.md 配置完限流规则并通过
# 验收测试后，将此变量设为 "true" 以通过 release-readiness 发布门控。
# 生产环境未设置或非 "true" 时 check-release-readiness --mode=production 会 BLOCK。
# Staging 环境未设置时仅 WARN（可在 WAF 配置前先部署 staging 验证应用层）。
# 仅接受精确字符串 "true"（区分大小写，"TRUE"/"1"/"yes" 均被拒绝）。
WAF_RATE_LIMIT_VERIFIED=

# KZQ-P1-012: 规范应用 Origin（仅服务端使用，绝不能加 NEXT_PUBLIC_ 前缀）
# 用于 CSRF 同源校验：isSameOrigin 会把浏览器 Origin 直接与此规范 Origin
# 比对（协议 + 主机名 + 规范化端口），不再依赖客户端可注入的
# x-forwarded-host / host 头。格式：https://kzq.example.com
# 未配置时回退到旧的 forwarded-host 比较（仅适用于本地开发）。
# 生产环境必须设置，避免攻击者伪造 x-forwarded-host 绕过同源校验。
CANONICAL_APP_ORIGIN=
# 可选：备用允许 Origin（逗号分隔），例如 www 变体或 staging 域名：
#   https://www.kzq.example.com,https://staging.kzq.example.com
# 仅 http/https 协议被接受；非法条目会被静默丢弃。
CANONICAL_APP_ORIGIN_ALTERNATES=

# 可选：新询盘通知（全部仅服务端使用；未配置时正常提交）
INQUIRY_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me
RESEND_API_KEY=re_replace_me
INQUIRY_NOTIFICATION_FROM=KZQ Website <inquiries@example.com>
INQUIRY_NOTIFICATION_TO=sales@example.com

# 可选：Outbox Dispatcher 入口（POST /api/internal/outbox/dispatch）的 Bearer Secret。
# 仅服务端使用，绝不能添加 NEXT_PUBLIC_ 前缀；至少 16 字符。
# 未设置或过短时该路由返回 503（fail-closed，dispatcher 处于禁用状态）。
# 询盘提交仍会写入 inquiry_outbox 行，但需要本 Secret 启用后由 Dispatcher 处理投递。
# Demo / 本地开发可不设置；生产 / Staging 应通过部署平台 Secret 配置强随机值。
OUTBOX_DISPATCH_SECRET=

# 可选：微信公众号网页 JS-SDK（仅服务端使用，绝不能添加 NEXT_PUBLIC_ 前缀）
# 两项同时配置后，仅微信内置浏览器会尝试启用；未配置时普通网页分享照常工作。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
